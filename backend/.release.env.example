# LogSonic release secrets — DO NOT COMMIT
# gitignore: backend/.release.env
# See backend/scripts/SIGNING.md for setup instructions

# Apple notarization (App Store Connect → Keys → AuthKey_*.p8)
# Note: notarization is optional for local tar.gz releases (Gatekeeper validates via hash).
# Fill in only if you want to submit binaries to Apple's notary service.
export MACOS_NOTARY_ISSUER_ID="<UUID from App Store Connect Keys page>"
export MACOS_NOTARY_KEY_ID="<10-character Key ID>"
export MACOS_NOTARY_KEY="$HOME/.config/logsonic/notary.p8"

# GitHub release token (https://github.com/settings/tokens, repo scope)
export GITHUB_TOKEN="<fine-grained or classic PAT with repo scope>"

# Homebrew tap token (https://github.com/settings/personal-access-tokens/new)
# Resource owner: logsonic
# Only repo: homebrew-logsonic
# Contents: Read and write
export HOMEBREW_TAP_TOKEN="<fine-grained PAT for logsonic/homebrew-logsonic>"
